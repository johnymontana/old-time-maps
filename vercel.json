{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(montana|flathead|glacier|gold|libby|yellowstone|paradise|bitterroot|front|rails|missouri|tacoma|coeurdalene|silverton|nome|mazama|luray|smoky|yosemite|brightangel|chisos|mountdesert|estes|kilauea|blackhills|art)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(montana|flathead|glacier|gold|libby|yellowstone|paradise|bitterroot|front|rails|missouri|tacoma|coeurdalene|silverton|nome|mazama|luray|smoky|yosemite|brightangel|chisos|mountdesert|estes|kilauea|blackhills|art)/card.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
